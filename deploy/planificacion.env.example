# /etc/planificacion/planificacion.env   (permisos 600, dueño: planificacion). NUNCA va al repositorio.
PLANIFICACION_ENTORNO=produccion
# Genera una clave larga y única:  python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=CAMBIAR-POR-UNA-CLAVE-LARGA-Y-UNICA
DJANGO_ALLOWED_HOSTS=planificacion.finanzashuentelauquen.cl
DJANGO_CSRF_TRUSTED_ORIGINS=https://planificacion.finanzashuentelauquen.cl
DJANGO_PROXY_SSL=1
PLANIFICACION_DB_PATH=/var/lib/planificacion/db.sqlite3
PLANIFICACION_EVIDENCIAS=/var/lib/planificacion/evidencias
PLANIFICACION_STATIC_ROOT=/var/www/planificacion/static
PLANIFICACION_RESPALDOS=/var/backups/planificacion
