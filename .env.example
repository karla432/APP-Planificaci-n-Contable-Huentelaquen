# Variables de entorno de PRODUCCIÓN. Copia este archivo FUERA del repositorio, complétalo y cárgalo en el servidor.
# NO guardes valores reales en archivos versionados.
PLANIFICACION_ENTORNO=produccion
# Clave secreta larga y aleatoria, distinta por servidor:
#   python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
DJANGO_SECRET_KEY=
# Servidores permitidos, separados por coma (sin http://)
DJANGO_ALLOWED_HOSTS=
DJANGO_CSRF_TRUSTED_ORIGINS=
# 1 solo si HTTPS termina en un proxy que envía X-Forwarded-Proto
DJANGO_PROXY_SSL=
# Ruta de la base SQLite (debe tener respaldo)
PLANIFICACION_DB_PATH=
